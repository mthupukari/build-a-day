# ============================================================
# Rideshare Compare — Environment Variables
# Copy this to .env.local and fill in your keys.
# NEVER commit .env.local to git.
# ============================================================

# --- Google Maps ---
# Get from: https://console.cloud.google.com
# Enable: Places API, Geocoding API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Exposed to browser for Places Autocomplete widget only
# This key should be restricted to your localhost domain in Google Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Uber ---
# Get from: https://developer.uber.com
# Scopes needed: price_estimates, ride_widgets
UBER_CLIENT_ID=your_uber_client_id_here
UBER_CLIENT_SECRET=your_uber_client_secret_here

# --- Lyft ---
# Get from: https://www.lyft.com/developers
# Use 2-legged OAuth (Client Credentials) — no user login needed for price estimates
LYFT_CLIENT_ID=your_lyft_client_id_here
LYFT_CLIENT_SECRET=your_lyft_client_secret_here

# --- Site Password (Vercel deployment) ---
# Protects your app — choose any password you like
SITE_PASSWORD=your_secret_password_here
